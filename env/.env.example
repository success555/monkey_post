# =======================================================================
# NAIJA STREET ARCADE — MASTER ENVIRONMENT CONFIGURATION
# =======================================================================
# Services Integrated:
# 1. Clerk Authentication (Player management, JWT sessions, Webhooks)
# 2. Supabase (PostgreSQL Database, Realtime, Storage Buckets for GLB 3D models)
# 3. Resend (High-speed transactional emails, match alerts, coin rewards)
# =======================================================================

# -----------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# -----------------------------------------------------------------------
# Publishable key (Client-side & Browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret Key (Server-side, Route Handlers, Backend API)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Webhook Secret (From Clerk Dashboard > Webhooks > Add Endpoint)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Route Paths (Next.js App Router default paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (https://supabase.com/dashboard)
# -----------------------------------------------------------------------
# Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Client-side with RLS policies enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxx

# Supabase Service Role Secret (Backend Admin Dashboard & API Routes ONLY — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxx

# Direct PostgreSQL Database Connection String (Optional, for Prisma / Drizzle / direct migrations)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------
# 3. RESEND EMAIL MANAGEMENT (https://resend.com)
# -----------------------------------------------------------------------
# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Sender Address
RESEND_FROM_EMAIL=Naija Street Arcade <arcade@yourverifieddomain.com>

# Admin Notification Recipient
ADMIN_NOTIFICATION_EMAIL=admin@naijastreet.com

# -----------------------------------------------------------------------
# 4. NEXT.JS APPLICATION SETTINGS
# -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

